[sub_resource type="GDScript" id="GDScript_gv5eo"]
script/source = "func is_room_complete(room: Node2D) -> bool:
	var pressed_count := 0
	for child in room.find_children(\"*\"):
		if child is BaseEnemy:
			return false
		if child is PressurePlate:
			if child.pressed:
				pressed_count += 1
	return room.get_node(\"Plates/Right\").pressed and pressed_count == 1
"

