[sub_resource type="GDScript" id="GDScript_1iw3y"]
script/source = "func is_room_complete(room: Node2D) -> bool:
	var pressed_count := 0
	for child in room.find_children(\"*\"):
		if child is PressurePlate:
			if child.pressed:
				pressed_count += 1
	return pressed_count == 1
"

