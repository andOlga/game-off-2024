[sub_resource type="GDScript" id="GDScript_i1n02"]
script/source = "extends Node2D

var blink_count := 0

func _on_label_timer_timeout() -> void:
	if not visible:
		blink_count += 1
	visible = not visible
	if blink_count == 5:
		queue_free()
"

