[sub_resource type="GDScript" id="GDScript_7o871"]
script/source = "extends Node2D

var count_left : int
var count_right : int

func _ready() -> void:
	count_left = $EnemiesLeft.get_child_count()
	count_right = $EnemiesRight.get_child_count()

func _on_key_tree_exiting() -> void:
	var key2 := get_node_or_null(\"Key2\")
	if key2:
		key2.get_node(\"Hitbox\").queue_free()
		key2.get_node(\"Sprite\").queue_free()

func _on_key_2_tree_exiting() -> void:
	var key1 := get_node_or_null(\"Key1\")
	if key1:
		key1.get_node(\"Hitbox\").queue_free()
		key1.get_node(\"Sprite\").queue_free()
"

