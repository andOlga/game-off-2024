[sub_resource type="GDScript" id="GDScript_0by5o"]
script/source = "func is_room_complete(room: Node2D) -> bool:
	return (
		room.get_node(\"EnemiesLeft\").get_child_count() == 0
		and room.get_node(\"EnemiesRight\").get_child_count() == room.count_right
	)
"

[sub_resource type="GDScript" id="GDScript_mhotr"]
script/source = "func is_room_complete(room: Node2D) -> bool:
	return (
		room.get_node(\"EnemiesLeft\").get_child_count() == room.count_left
		and room.get_node(\"EnemiesRight\").get_child_count() == 0
	)
"

