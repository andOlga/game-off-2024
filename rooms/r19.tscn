[sub_resource type="GDScript" id="GDScript_drd8l"]
script/source = "extends Node2D

func _on_pressure_plate_toggled(_new_state: bool) -> void:
	$Door.toggle()
"

[sub_resource type="GDScript" id="GDScript_7c8x6"]
script/source = "func is_room_complete(room: Node2D) -> bool:
	for child in room.find_children(\"*\"):
		if child is BaseEnemy:
			return false
		if child is PressurePlate:
			if not child.pressed:
				return false
	return true
"

