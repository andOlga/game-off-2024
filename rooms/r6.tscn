[sub_resource type="GDScript" id="GDScript_m2sn4"]
script/source = "func is_room_complete(room: Node2D) -> bool:
	return (
		room.find_children(\"Flyer*\").is_empty()
		and room.find_children(\"Hopper*\").size() == 2
		and room.find_children(\"Walker*\").size() == 2 * 2 # include WalkerInternal
	)
"

